---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import drssaCastorina from '../assets/drssa-castorina.jpg';
import drMancini from '../assets/dr-mancini.jpg';
import drssaAmico from '../assets/drssa-amico.jpg';
import drssaRamondetta from '../assets/drssa-ramondetta.jpg';
---

<Layout title="Home" description="Clinica di Medicina e Chirurgia Estetica, Dermatologia, Centro Laser, Epilazione e Dimagrimento a Catania e Milano">
  
  <!-- 1. HERO SECTION -->
  <section class="relative mt-30 pt-8 pb-20 md:pt-6 md:pb-10 flex items-center overflow-hidden border-b border-neutral-100">
    
    <!-- Contenuto Hero -->
    <div class="relative max-w-7xl mx-auto px-6 w-full">
      <div class="max-w-2xl text-black">

        <h1 class="text-l sm:text-5xl lg:text-6xl font-extrabold tracking-tight mt-3 leading-tight">
          Clinica di Medicina Estetica a Catania & Milano
        </h1>

        <!-- Descrizione Dott.ssa Castorina -->
        <p class="font-light mt-6 text-base sm:text-lg leading-relaxed">
          Diretta dalla Dott.ssa Milena Castorina, specialista in ricostruzione e rimodellamento del viso con iniettabili con oltre 20 anni di esperienza.
        </p>

        <!-- Bottoni CTA & Numero Telefonico -->
        <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <a 
            href="https://wa.me/393407699438?text=Buongiorno,%20vorrei%20prenotare%20una%20consulenza." 
            target="_blank" 
            rel="noopener noreferrer"
            class="gap-2 inline-flex justify-center items-center bg-[#20ba5a] text-white px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-[#1ca953] transition-all"
          >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
            Prenota su WhatsApp
          </a>
          
          <a 
            href="tel:+393407699438" 
            class="text-xs sm:text-sm font-medium hover:text-neutral-900 transition-colors flex items-center gap-1"
          >
            o chiama il <span class="underline underline-offset-4 font-semibold ml-1">(+39) 340 769 9438</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  
  <!-- 2. IL NOSTRO TEAM (COMPETENZA & SICUREZZA) --> 
   <section class="py-24 px-6 max-w-7xl mx-auto border-b border-neutral-100"> 
    <!-- INTRO --> 
     <div class="max-w-3xl mb-12"> 
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#111111] mt-2"> L'equipe di OG Medica </h2> 
      <p class="text-neutral-600 font-light mt-4 leading-relaxed text-base">
    Un team di supporto unico e competente che lavora da anni a stretto contatto con la Dr.ssa Milena Castorina per accompagnarvi in ogni fase della Medicina Estetica Avanzata.
      </p>
     </div>


<!-- CARDS TEAM -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">

  <!-- ======================================== -->
<!-- DR.SSA MILENA CASTORINA -->
<!-- ======================================== -->

<div
  class="bg-neutral-50 rounded-3xl border border-neutral-200/60 overflow-hidden grid grid-cols-1 sm:grid-cols-[45%_55%] md:grid-cols-1 lg:grid-cols-[45%_55%]"
>

  <!-- Immagine -->
  <div class="min-h-[280px] sm:min-h-[320px] lg:min-h-full">
    <img
      src={drssaCastorina.src}
      alt="Dr.ssa Milena Castorina"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Contenuto -->
  <div class="p-6 flex flex-col justify-center">

    <h3 class="text-xl font-bold text-[#111111]">
      Dr.ssa Milena Castorina
    </h3>

    <p class="text-xs text-neutral-500 uppercase tracking-widest font-semibold mt-2">
      Direttrice e Facial Injector Specialist
    </p>

    <p class="text-neutral-600 font-light text-xs mt-4 leading-relaxed">
      La Dott.ssa Milena Castorina si occupa di medicina estetica iniettiva
      avanzata per l’abbellimento e il ringiovanimento e in particolare per
      il rimodellamento del volto e del corpo in tutta Italia – in particolare
      a Milano, Montecatini e Catania – utilizzando metodiche combinate poco
      invasive e altamente efficaci.
    </p>

  </div>

</div>


<!-- ======================================== -->
<!-- DR. GIANMARIA MANCINI -->
<!-- ======================================== -->

<div
  class="bg-neutral-50 rounded-3xl border border-neutral-200/60 overflow-hidden grid grid-cols-1 sm:grid-cols-[45%_55%] md:grid-cols-1 lg:grid-cols-[45%_55%]"
>

  <!-- Immagine -->
  <div class="min-h-[280px] sm:min-h-[320px] lg:min-h-full">
    <img
      src={drMancini.src}
      alt="Dr. Gianmaria Mancini"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Contenuto -->
  <div class="p-6 flex flex-col justify-center">

    <h3 class="text-xl font-bold text-[#111111]">
      Dr. Gianmaria Mancini
    </h3>

    <p class="text-xs text-neutral-500 uppercase tracking-widest font-semibold mt-2">
      Master in Chirurgia Plastica
    </p>

    <p class="text-neutral-600 font-light text-xs mt-4 leading-relaxed">
      Dr. Mancini dedica ai suoi pazienti la migliore combinazione tra
      tempo, dedizione, cura del dettaglio. Da anni esperto nell’impiego
      di apparecchiature medicali di ultima generazione, quali Laser Co2
      Frazionato, Laser ad Alessandrite e Laser Nd:YAG.
    </p>

  </div>

</div>


<!-- ======================================== -->
<!-- DR.SSA VALENTINA AMICO -->
<!-- ======================================== -->

<div
  class="bg-neutral-50 rounded-3xl border border-neutral-200/60 overflow-hidden grid grid-cols-1 sm:grid-cols-[45%_55%] md:grid-cols-1 lg:grid-cols-[45%_55%]"
>

  <!-- Immagine -->
  <div class="min-h-[280px] sm:min-h-[320px] lg:min-h-full">
    <img
      src={drssaAmico.src}
      alt="Dr.ssa Valentina Amico"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Contenuto -->
  <div class="p-6 flex flex-col justify-center">

    <h3 class="text-xl font-bold text-[#111111]">
      Dr.ssa Valentina Amico
    </h3>

    <p class="text-xs text-neutral-500 uppercase tracking-widest font-semibold mt-2">
      Specialista in Biochimica e Chimica Clinica
    </p>

    <p class="text-neutral-600 font-light text-xs mt-4 leading-relaxed">
      Esperta in Nutrizione Clinica, la Dott.ssa Amico formula piani
      dietetici personalizzati per ogni fascia d’età, con l’obiettivo
      di migliorare la salute e il benessere dell’organismo, anche in
      presenza di patologie o disturbi del comportamento alimentare.
    </p>

  </div>

</div>


<!-- ======================================== -->
<!-- DR.SSA ALICE RAMONDETTA -->
<!-- ======================================== -->

<div
  class="bg-neutral-50 rounded-3xl border border-neutral-200/60 overflow-hidden grid grid-cols-1 sm:grid-cols-[45%_55%] md:grid-cols-1 lg:grid-cols-[45%_55%]"
>

  <!-- Immagine -->
  <div class="min-h-[280px] sm:min-h-[320px] lg:min-h-full">
    <img
      src={drssaRamondetta.src}
      alt="Dr.ssa Alice Ramondetta"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Contenuto -->
  <div class="p-6 flex flex-col justify-center">

    <h3 class="text-xl font-bold text-[#111111]">
      Dr.ssa Alice Ramondetta
    </h3>

    <p class="text-xs text-neutral-500 uppercase tracking-widest font-semibold mt-2">
      Dermatologa esperta nella Mappatura dei Nei e Trattamento Acne
    </p>

    <p class="text-neutral-600 font-light text-xs mt-4 leading-relaxed">
      La Dottoressa Alice Ramondetta è esperta nella mappatura dei nei,
      nel trattamento dell’acne e delle patologie dermatologiche
      pediatriche, nella gestione di malattie dermatologiche autoimmuni,
      dell’orticaria e delle malattie dermatologiche genitali e di quelle
      sessualmente trasmesse.
    </p>

  </div>

</div>

</div>


  <!-- CTA -->
  <div class="mt-12 text-center">

    <a
      href="/team"
      class="inline-flex items-center justify-center bg-neutral-100 text-[#111111] px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-neutral-200 transition-all border border-neutral-200/80"
    >
      Scopri di più sul nostro Team &rarr;
    </a>

  </div>

  </section>



    <!-- 4. Recensioni dei Pazienti -->
  <section class="py-20 px-6 max-w-7xl mx-auto border-b border-neutral-100">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#111111] mt-2">Testimonial</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
      <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-200/60">
        <p class="text-xs text-neutral-600 font-light leading-relaxed">Ho avuto un'esperienza davvero ottima. La dottoressa Milena Castorina e tutto il suo staff si distinguono per professionalità, competenza e grande gentilezza. Mi sono sentita accolta e seguita con attenzione in ogni momento. L'approccio è sempre personalizzato, rispettoso e orientato a valorizzare ogni persona con naturalezza. Consiglio vivamente lo studio OG Medica a chi cerca serietà, qualità e risultati.</p>
        <span class="block text-xs font-bold text-[#111111] mt-4">Roberta Bonsignore</span>
      </div>
      <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-200/60">
        <p class="text-xs text-neutral-600 font-light leading-relaxed">Mi sono sottoposta ad un trattamento si blefarofiller e che dire...! Sorprendente! La dott.ssa Castorina, con la sua competenza, ineccepibile professionalità e preparazione, ha eseguito un lavoro magistrale, la tecnica innovativa di ricostruzione iniettiva mi ha permesso di ottenere risultati ottimali senza ricorrere alla chirurgia. Davvero incredibile quello che è riuscita a fare in pochissimo tempo. Il mio sguardo ha acquisito armonia , naturalezza e luminosità. Eccellente! Complimenti anche a tutto lo staff.</p>
        <span class="block text-xs font-bold text-[#111111] mt-4">Debora De Luca</span>
      </div>
      <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-200/60">
        <p class="text-xs text-neutral-600 font-light leading-relaxed">Esperienza più che positiva, mi sono sentita a casa sin dal primo momento. Dopo la consulenza con la Dott.ssa Castorina abbiamo stilato insieme il percorso più adatto alle mie esigenze. Ho iniziato il trattamento con Selenia, sua collaboratrice, che si è dimostrata sin da subito professionale ed empatica: mi ha spiegato ogni passaggio con chiarezza e delicatezza, ha fugato ogni mio dubbio e mi ha messa a mio agio come pochi. Non potevo aspettarmi di meglio. Centro OG Medica consigliatissimo!</p>
        <span class="block text-xs font-bold text-[#111111] mt-4">Chiara Centamore</span>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/sedi" class="inline-flex items-center justify-center bg-neutral-100 text-[#111111] px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-neutral-200 transition-all border border-neutral-200/80">
        Guarda la Galleria Risultati &rarr;
      </a>
    </div>
  </section>

  <!-- 5. DOVE CI TROVIAMO & SEDI (INFO PRATICHE) -->
  <section class="py-24 px-6 max-w-7xl mx-auto border-b border-neutral-100">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#111111] mt-2">Dove Ci Troviamo</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Sede Catania -->
      <div class="bg-white p-8 rounded-3xl border border-neutral-200/80 flex flex-col justify-between">
        <div>
          <h3 class="text-2xl font-bold text-[#111111] mt-2">Catania</h3>
          <p class="text-xs text-neutral-600 mt-4 leading-relaxed">
            Via Gustavo Vagliasindi, 52 - 2° Piano<br />
            <strong>Orari:</strong> Lun, Mer e Ven dalle 14:00 alle 19:30
          </p>
        </div>
        <div class="mt-8">
          <a 
            href="https://maps.google.com/?q=Via+Gustavo+Vagliasindi+52+Catania" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-semibold uppercase tracking-wider text-[#111111] underline"
          >
            Calcola percorso Catania &rarr;
          </a>
        </div>
      </div>

      <!-- Sede Milano -->
      <div class="bg-white p-8 rounded-3xl border border-neutral-200/80 flex flex-col justify-between">
        <div>
          <h3 class="text-2xl font-bold text-[#111111] mt-2">Milano</h3>
          <p class="text-xs text-neutral-600 mt-4 leading-relaxed">
            Via Giuseppe Broggi, 8<br />
            <strong>Orari:</strong> Lun, Mer e Ven dalle 14:00 alle 19:30
          </p>
        </div>
        <div class="mt-8">
          <a 
            href="https://maps.google.com/?q=Via+Cristoforo+Colombo+129+Milano" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-semibold uppercase tracking-wider text-[#111111] underline"
          >
            Calcola percorso Milano &rarr;
          </a>
        </div>
      </div>

    </div>

    <div class="mt-12 text-center">
      <a href="/sedi" class="inline-flex items-center justify-center bg-[#111111] text-white px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-neutral-800 transition-all">
        Vedi le nostre Sedi &rarr;
      </a>
    </div>
  </section>

  <!-- 6. CTA FINALE -->
  <section class="py-20 px-6 max-w-7xl mx-auto">
    <div class="bg-neutral-900 text-white rounded-3xl p-10 md:p-16 text-center max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight">Prenota la tua prima visita di valutazione</h2>
      <p class="text-neutral-400 font-light mt-4 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
        Contatta la segreteria medica via WhatsApp o invia un messaggio per richiedere informazioni sui trattamenti e sulla disponibilità.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <a 
          href="https://wa.me/393407699438?text=Buongiorno,%20desidero%20prenotare%20una%20visita." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block bg-white text-[#111111] px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-neutral-200 transition-all shadow-md"
        >
          WhatsApp Diretto: +39 3407699438
        </a>
      </div>
    </div>
  </section>

</Layout>