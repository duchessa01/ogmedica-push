---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

const {
  title = "OG Medica",
  description = "Clinica di Medicina Estetica Avanzata - Risultati naturali e protocolli medici su misura.",
  image = "/og-image.jpg",
  canonical,
  type = "website"
} = Astro.props;

// URL del sito
const siteUrl = "https://www.ogmedica-push.vercel.app";

// URL canonico della pagina corrente
const canonicalUrl = canonical
  ? `${siteUrl}${canonical}`
  : Astro.url.href;

// URL assoluto dell'immagine Open Graph
const ogImage = image.startsWith("http")
  ? image
  : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <!-- Astro -->
    <meta
      name="generator"
      content={Astro.generator}
    />

    <!-- SEO -->
    <title>{title} | OG Medica</title>

    <meta
      name="description"
      content={description}
    />

    <!-- Canonical -->
    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content={type}
    />

    <meta
      property="og:title"
      content={`${title} | OG Medica`}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:site_name"
      content="OG Medica"
    />

    <meta
      property="og:locale"
      content="it_IT"
    />

    <meta
      property="og:image"
      content={ogImage}
    />

    <meta
      property="og:image:alt"
      content={`${title} - OG Medica`}
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={`${title} | OG Medica`}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={ogImage}
    />

  </head>

  <body
    class="bg-white text-[#111111] font-sans antialiased selection:bg-[#111111] selection:text-white flex flex-col min-h-screen"
  >

    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Widget WhatsApp Sempre Visibile -->
    <WhatsAppWidget />

  </body>
</html>